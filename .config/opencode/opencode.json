      "description": "Setup ESLint, Prettier and dev tools",
      "agent": "ANGULAR",
      "skill": "angular-tooling"
    },
    "enable-ssr": {
      "description": "Enable server-side rendering with AnalogJS",
      "agent": "ANGULAR",
      "skill": "angular-ssr"
    },
    "design-ui": {
      "description": "Design UI components",
      "agent": "DESIGN",
      "skill": "frontend-design"
    },
